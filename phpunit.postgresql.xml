<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/postgresql-bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL">
            <directory>tests/PostgreSQL</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:dGVzdGluZy1rZXktdGVzdGluZy1rZXktdGVzdGluZyE="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="JWT_SECRET" value="eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eA=="/>
        <env name="JWT_TTL" value="720"/>
        <env name="TURNSTILE_SITE_KEY" value="test-site-key"/>
        <env name="TURNSTILE_SECRET_KEY" value="test-secret-key"/>
        <env name="REGISTRATION_ENABLED" value="true"/>
        <env name="TEAM_REGISTRATION_ENABLED" value="true"/>
        <env name="TOURNAMENT_ENABLED" value="false" force="true"/>
        <server name="TOURNAMENT_ENABLED" value="false"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Database credentials and server identity come only from the disposable runner. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
